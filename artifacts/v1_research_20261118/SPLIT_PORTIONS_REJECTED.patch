+// Split both sides using one traversal; each row retains the exact original
+// IEEE operations and order. This does not aggregate packets or change the
+// traffic model and cannot address packet-count growth by itself.
+fn split_portions(parts: &PacketParts, f: f64) -> PyResult<(Vec<Part>, Vec<Part>)> {
+    let g = 1. - f;
+    let mut served = checkpoint_vec(if f == 0. { 0 } else { parts.len() })?;
+    let mut remaining = checkpoint_vec(if g == 0. { 0 } else { parts.len() })?;
+    for p in parts {
+        let m = p.mass * f;
+        if m > 0. {
+            let mut q = p.clone();
+            q.mass = m;
+            q.birth *= f;
+            served.push(q);
+        }
+        let remainder_mass = p.mass * g;
+        if remainder_mass > 0. {
+            let mut q = p.clone();
+            q.mass = remainder_mass;
+            q.birth *= g;
+            remaining.push(q);
+        }
+    }
+    Ok((served, remaining))
 }
